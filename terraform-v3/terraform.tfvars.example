# Example configuration - copy to terraform.tfvars and update with your values

aws_region      = "us-east-1"
aws_account_id  = "123456789012"
s3_bucket_name  = "my-agentcore-cache-bucket"
agent_name      = "my_observability_agent_v3_tf"
ecr_repository_url = "123456789012.dkr.ecr.us-east-1.amazonaws.com/my-agentcore-repo"
